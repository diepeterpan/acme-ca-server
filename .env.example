# ==========================================
# ACME CA Server - Local Environment Config
# Copy this file to .env and adjust values
# ==========================================

# Public URL of the server (use https in production)
EXTERNAL_URL=http://localhost:8080

# PostgreSQL Database Connection String
DB_DSN=postgresql://postgres:secret@localhost:5432/postgres

# Fernet encryption key for private CA keys in database
# Generate a new key with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CA_ENCRYPTION_KEY=Ka7prX3ZqESxa79C3kqWOI1cV979B-x7A7NT5-nU2p0=

# ACME protocol settings
ACME_MAIL_REQUIRED=False

# Optional: Pre-provision Web Admin credentials on first start
# If left commented out, you will be prompted to create an admin account at /setup
# WEB_ADMIN_USERNAME=admin
# WEB_ADMIN_PASSWORD=change_this_secret_password

# Optional: Session cookie signing secret (defaults to CA_ENCRYPTION_KEY if unset)
# WEB_SESSION_SECRET=

# Optional: OpenID Connect (OIDC) Authentication (e.g., Authelia, Keycloak, Authentik)
# OIDC_ENABLED=True
# OIDC_ISSUER_URL=https://auth.example.com
# OIDC_CLIENT_ID=acme-ca-server
# OIDC_CLIENT_SECRET=your_oidc_client_secret
# OIDC_BUTTON_LABEL=Sign In with Authelia
# OIDC_SCOPES=openid profile email
# OIDC_REDIRECT_URL=http://localhost:8080/oidc/callback
# OIDC_USER_CLAIM=email
# OIDC_VERIFY_SSL=True
# Set to False to relax strict X.509 certificate requirements for older or non-standard IdP certificates (e.g. in Python 3.10+ / OpenSSL 3+)
# OIDC_X509_REQUIRED=True
# Enable PKCE (Proof Key for Code Exchange - RFC 7636) for authorization code flow (required by Authelia, Keycloak 22+)
# OIDC_USE_PKCE=True
# Client authentication method for token exchange: 'auto' (default), 'client_secret_basic', or 'client_secret_post'
# OIDC_TOKEN_AUTH_METHOD=auto
